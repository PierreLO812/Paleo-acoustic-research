{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paleo-acoustic-research.local/schemas/metrics.schema.json",
  "title": "Paleo-Acoustic Pipeline Metrics v2.0 / v2.1",
  "type": "object",
  "required": [
    "schema_version",
    "taxon",
    "specimen_id",
    "taxon_slug",
    "run_id",
    "created_at_utc",
    "git_commit",
    "seed",
    "sample_rate",
    "duration_s",
    "synth_mode",
    "state",
    "f0",
    "formant_targets_hz",
    "formants_measured",
    "formants_predicted_tmm",
    "analytic",
    "band_energy_fractions",
    "shaping_gain_db_F1",
    "source_spectral_tilt_db_per_oct",
    "kl_vs_tmm_rel_err",
    "geometry_qc",
    "review",
    "assumptions",
    "audio",
    "warnings",
    "deprecated"
  ],
  "not": {
    "required": ["formant_peaks_hz"]
  },
  "properties": {
    "schema_version": { "type": "string", "enum": ["2.0", "2.1"] },
    "taxon": { "type": "string", "minLength": 1 },
    "specimen_id": { "type": "string", "minLength": 1 },
    "taxon_slug": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "git_commit": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["git_commit", "git_commit_full", "git_dirty", "git_describe"],
      "properties": {
        "git_commit": { "type": "string" },
        "git_commit_full": { "type": "string" },
        "git_dirty": { "type": "boolean" },
        "git_describe": { "type": "string" }
      }
    },
    "seed": { "type": "integer" },
    "sample_rate": { "type": "integer", "minimum": 8000 },
    "duration_s": { "type": "number", "exclusiveMinimum": 0 },
    "synth_mode": { "type": "string", "enum": ["kl", "legacy_iir", "tmm_fir"] },
    "independent_of_tmm": { "type": "boolean" },
    "state": {
      "type": "string",
      "enum": [
        "HYPOTHESIS",
        "PEER_REVIEW",
        "REVIEW_FAILED",
        "CONTRACT_OK",
        "EXPLORATORY",
        "SCIENTIFICALLY_VALIDATED"
      ]
    },
    "f0": {
      "type": "object",
      "required": ["prior_hz", "measured_hz", "measured_std_hz", "method"],
      "properties": {
        "prior_hz": { "type": "number", "exclusiveMinimum": 0 },
        "measured_hz": { "type": "number", "minimum": 0 },
        "measured_std_hz": { "type": "number", "minimum": 0 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "formant_targets_hz": {
      "type": "array",
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "formants_measured": {
      "type": "object",
      "required": ["transfer_function", "lpc"],
      "properties": {
        "transfer_function": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["f_hz", "bw_3db_hz", "q", "coherence"],
            "properties": {
              "f_hz": { "type": "number", "exclusiveMinimum": 0 },
              "bw_3db_hz": { "type": "number", "exclusiveMinimum": 0 },
              "q": { "type": "number", "minimum": 0 },
              "coherence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "lpc": {
          "type": "object",
          "required": ["f_hz", "bw_hz", "order", "fs_lpc", "reliability"],
          "properties": {
            "f_hz": { "type": "array", "items": { "type": "number" } },
            "bw_hz": { "type": "array", "items": { "type": "number" } },
            "order": { "type": "integer", "minimum": 2 },
            "fs_lpc": { "type": "integer", "minimum": 2000 },
            "reliability": { "type": "string", "enum": ["low", "ok"] }
          }
        }
      }
    },
    "formants_predicted_tmm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["f_hz", "bw_3db_hz", "q"],
        "properties": {
          "f_hz": { "type": "number", "exclusiveMinimum": 0 },
          "bw_3db_hz": { "type": "number", "exclusiveMinimum": 0 },
          "q": { "type": "number", "minimum": 0 }
        }
      }
    },
    "formants_predicted_tmm_bone": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["f_hz", "bw_3db_hz", "q"],
        "properties": {
          "f_hz": { "type": "number", "exclusiveMinimum": 0 },
          "bw_3db_hz": { "type": "number", "exclusiveMinimum": 0 },
          "q": { "type": "number", "minimum": 0 }
        }
      }
    },
    "formants_predicted_tmm_soft": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["f_hz", "bw_3db_hz", "q"],
        "properties": {
          "f_hz": { "type": "number", "exclusiveMinimum": 0 },
          "bw_3db_hz": { "type": "number", "exclusiveMinimum": 0 },
          "q": { "type": "number", "minimum": 0 }
        }
      }
    },
    "analytic": {
      "type": "object",
      "required": ["L_m", "L_eff_m", "c_m_s", "closed_open_hz", "open_open_hz"],
      "properties": {
        "L_m": { "type": "number", "exclusiveMinimum": 0 },
        "L_eff_m": { "type": "number", "exclusiveMinimum": 0 },
        "c_m_s": { "type": "number", "exclusiveMinimum": 0 },
        "closed_open_hz": { "type": "array", "items": { "type": "number" } },
        "open_open_hz": { "type": "array", "items": { "type": "number" } }
      }
    },
    "band_energy_fractions": {
      "type": "object",
      "required": ["filtered", "source"],
      "properties": {
        "filtered": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "source": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "shaping_gain_db_F1": { "type": "number" },
    "shaping": {
      "type": "object",
      "required": ["b3db", "pm60", "shaping_gain_db_F1_b3db", "shaping_gain_db_F1_pm60", "f1_band_energy_fraction_measured_pm60"],
      "properties": {
        "b3db": { "type": "object" },
        "pm60": { "type": "object" },
        "shaping_gain_db_F1_b3db": { "type": "number" },
        "shaping_gain_db_F1_pm60": { "type": "number" },
        "f1_band_energy_fraction_measured_pm60": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "source_spectral_tilt_db_per_oct": { "type": "number" },
    "kl_vs_tmm_rel_err": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "kl_vs_tmm": {
      "type": "object",
      "required": ["freq_rel_err", "q_rel_err", "loss_model", "fit_rms_db"],
      "properties": {
        "freq_rel_err": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "q_rel_err": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "loss_model": { "type": "string", "enum": ["kirchhoff_fit", "legacy"] },
        "fit_rms_db": { "type": ["object", "null"] }
      }
    },
    "geometry_qc": {
      "type": "object",
      "required": [
        "status",
        "flags",
        "L_mm",
        "A_mean_mm2",
        "A_max_mm2",
        "Dh_mean_mm",
        "source_mesh",
        "extraction_method"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["AIRWAY_OK", "BONE_DERIVED_EXPLORATORY", "UNKNOWN"]
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "L_mm": { "type": "number", "exclusiveMinimum": 0 },
        "A_mean_mm2": { "type": "number", "exclusiveMinimum": 0 },
        "A_max_mm2": { "type": "number", "exclusiveMinimum": 0 },
        "Dh_mean_mm": { "type": "number", "exclusiveMinimum": 0 },
        "source_mesh": { "type": "string" },
        "extraction_method": { "type": "string" },
        "end_section": {
          "type": "object",
          "required": ["end_section_artifact", "flagged_indices", "trimmed", "trimmed_indices"],
          "properties": {
            "end_section_artifact": { "type": "boolean" },
            "flagged_indices": { "type": "array", "items": { "type": "integer" } },
            "trimmed": { "type": "boolean" },
            "trimmed_indices": { "type": "array", "items": { "type": "integer" } }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["passed", "issues", "tolerances", "retry_feedback"],
      "properties": {
        "passed": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } },
        "tolerances": { "type": "object" },
        "retry_feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issue", "observed", "expected", "suggested_action"],
            "properties": {
              "issue": { "type": "string" },
              "observed": {},
              "expected": {},
              "suggested_action": { "type": "string" }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "object",
      "required": ["air", "soft_tissue", "radiation_model"],
      "properties": {
        "air": { "type": "object" },
        "soft_tissue": { "type": "object" },
        "radiation_model": { "type": "string" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["peak_dbfs", "clipping_detected"],
      "properties": {
        "peak_dbfs": { "type": "number" },
        "clipping_detected": { "type": "boolean" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deprecated": {
      "type": "object",
      "required": ["formant_peaks_hz"],
      "properties": {
        "formant_peaks_hz": { "type": "string" },
        "shaping_gain_db_F1": { "type": "string" }
      }
    },
    "sensitivity": {
      "type": "object",
      "required": ["status", "path", "summary"],
      "properties": {
        "status": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "summary": { "type": ["object", "null"] }
      }
    },
    "epb": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string" }
      }
    },
    "looped_airway": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string" }
      }
    },
    "what_if": {
      "type": "object",
      "required": ["enabled", "synthetic", "paths"],
      "properties": {
        "enabled": { "type": "boolean" },
        "synthetic": { "type": "boolean" },
        "paths": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "2.1" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "provenance",
          "kl_vs_tmm",
          "shaping",
          "formants_predicted_tmm_soft",
          "sensitivity",
          "epb",
          "looped_airway",
          "what_if"
        ],
        "properties": {
          "geometry_qc": { "required": ["end_section"] },
          "assumptions": {
            "properties": {
              "soft_tissue": {
                "required": ["enabled", "state_effect", "nominal_values", "parameters"]
              }
            }
          }
        }
      }
    }
  ]
}
